{
  // F3 验收契约谈判（≤2 轮）：执行者拟断言 → 跨家族挑战者逐条挑战
  // SOURCES_MANIFEST 提供素材文件绝对路径（M2-2 联调修复：挑战者曾因缺路径读不到证据源）
  "agents": ["claim_drafter", "contract_challenger"],
  "inputs": {
    "PLAN_PATH": "output/论文_计划.md",
    "SOURCES_MANIFEST": "output/SOURCES_MANIFEST.json"
  },
  "tasks": [
    {
      "name": "draft_assertions",
      "agent": "claim_drafter",
      "description": "依据论文计划 {PLAN_PATH} 拟定 10-20 条可检验断言（覆盖数值范围、结论边界、图表与正文对应关系），每条断言必须可由素材文件判定真伪。素材文件的实际绝对路径以素材清单 {SOURCES_MANIFEST} 的 path 字段为准（需核验原文时用 FileReadTool 按该绝对路径读取）。",
      "expected_output": "断言清单表格（编号 | 断言 | 判定依据）。",
      "output_file": "output/契约_断言草案.md"
    },
    {
      "name": "challenge_assertions",
      "agent": "contract_challenger",
      "context": ["draft_assertions"],
      "description": "逐条挑战断言：是否可测？证据是否真的可得？是否存在过度承诺？判定证据可得性前，必须先用 FileReadTool 按素材清单 {SOURCES_MANIFEST} 中 path 字段给出的绝对路径实际读取素材文件（禁止凭路径猜测下结论）。输出挑战意见表（编号 | 结论：接受/需修订 | 理由 | 修订建议）。若全部接受，契约状态行写「状态：accepted」；存在未消解分歧写「状态：contested」并附双方立场。",
      "expected_output": "Markdown 契约文档，首部含「状态：accepted/contested」行。",
      "output_file": "output/验收_契约.md"
    }
  ]
}
