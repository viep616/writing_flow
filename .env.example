DASHSCOPE_API_KEY=你的密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 跨家族评审（deepseek-v4-pro）经百炼兼容模式调用：
# crewai 原生 deepseek/ 前缀只认 DEEPSEEK_API_KEY + DEEPSEEK_BASE_URL，故复制同 key 并指向百炼
DEEPSEEK_API_KEY=你的密钥（同 DASHSCOPE_API_KEY）
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：评审家族降级开关（deepseek=跨家族默认；qwen=同家族降级，评审结论将标 provisional）
# WRITING_FLOW_REVIEWER_FAMILY=deepseek
# 可选：桩模式（不调 LLM，验证全链路）
# WRITING_FLOW_STUB=1
# 可选：留档时尝试生成 PDF（需 pandoc + xelatex，缺失自动跳过）
# WRITING_FLOW_PDF=1
