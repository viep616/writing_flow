{
  // F6 致命一击：敌意审稿人单发最强拒稿段 → 裁判拆原子点三分类（verdict 由 verdict_map.py 代码映射）
  "agents": ["killer", "arbiter"],
  "inputs": {
    "DRAFT_PATH": "output/论文_初稿.md"
  },
  "tasks": [
    {
      "name": "kill_attack",
      "agent": "killer",
      "description": "扮演最敌意的审稿人，针对论文 {DRAFT_PATH} 提交单一致命拒稿段（约 200 字）：从六轴择优组合——结论有效性 / 假设-主张错配 / 缺失证据义务 / 数值歧义 / 证据-主张差距 / 范围过卖。必须引用具体章节或数据条目，禁止含糊表态，禁止给修复建议（攻击只管杀伤）。",
      "expected_output": "一段约 200 字的拒稿论述。",
      "output_file": "output/致命_攻击段.md"
    },
    {
      "name": "arbitrate_atoms",
      "agent": "arbiter",
      "context": ["kill_attack"],
      "description": "把攻击拆解为 3-7 个原子拒稿点，逐点对照论文当前文本三分类并给严重度。输出严格 JSON：{\"atoms\": [{\"id\":\"a1\",\"point\":\"...\",\"disposition\":\"answered_by_current_text|partially_answered|still_unresolved\",\"severity\":\"critical|major|minor\",\"evidence\":\"章节/数据条目\"}]}。措辞如实，不使用 fixed 之类的乐观暗示；顶层结论不要自行给出（由代码按计数表映射）。",
      "expected_output": "单个 JSON 对象，atoms 数组 3-7 条。",
      "output_file": "output/致命_原子点.json"
    }
  ]
}
