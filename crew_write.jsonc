{
  // F4 分节写作：主题锚定 + 数值纪律 + 雷区黑名单（条款回收自 sf6 初探实测有效的 prompt 资产）
  "agents": ["section_writer"],
  "inputs": {
    "PLAN_PATH": "output/论文_计划.md",
    "CONTRACT_PATH": "output/验收_契约.md",
    "SOURCES_MANIFEST": "output/SOURCES_MANIFEST.json"
  },
  "tasks": [
    {
      "name": "write_sections",
      "agent": "section_writer",
      "description": "按论文计划 {PLAN_PATH} 的章节结构逐节写作全文，遵守验收契约 {CONTRACT_PATH}。四条最高纪律：1) 主题锚定——全文只围绕计划锚定的课题，禁止改写为其他课题；2) 数值纪律——计算设置与物理量只照抄数据表原文，公式只写符号不代数值；聚合统计纪律——位点排序/位次（含并列）/频次/占比/收敛性等聚合数值一律直接引用数据表 §5「分析素材」（qe_extract 代码生成），禁止自行统计、重新计算或改标位次；数据表等素材文件的绝对路径以素材清单 {SOURCES_MANIFEST} 的 path 字段为准，引用数值前须实际读取原文核对；3) 雷区黑名单——禁止使用文献默认值替代数据表值，禁止换用近似值绕过；4) 配图纪律——需要配图的论述段落后插入图锚点 `<!-- FIG:qe_fig1_site_map -->`（可用锚点：qe_fig1_site_map 位点热力图 / qe_fig2_site_flip 位点翻转 / qe_fig3_outlier 异常构型 / qe_fig4_convergence 收敛性；图与图注由程序生成并在锚点处插入）；无对应论述段落不得插图、不得自行写图片路径。缺证据处写 <!-- DATA_NEEDED: 缺什么 --> 注释，不得编造。参考文献每条标注（待核实）。",
      "expected_output": "完整论文初稿 Markdown，含全部章节；无围栏包裹。",
      "output_file": "output/论文_初稿.md"
    }
  ]
}
